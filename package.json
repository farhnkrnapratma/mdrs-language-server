{
    "name": "@mdrs/language-server",
    "version": "0.2.0",
    "description": "Language server for MDRS (Markdown Rich Syntax): diagnostics, completion, hover, symbols and folding.",
    "license": "MIT OR Apache-2.0",
    "author": "Farhan Kurnia Pratama",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/farhnkrnapratma/mdrs-language-server.git"
    },
    "bugs": "https://github.com/farhnkrnapratma/mdrs-language-server/issues",
    "homepage": "https://github.com/farhnkrnapratma/mdrs-language-server#readme",
    "keywords": [
        "mdrs",
        "markdown",
        "lsp",
        "language-server",
        "language-server-protocol"
    ],
    "type": "module",
    "bin": {
        "mdrs-language-server": "dist/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "default": "./dist/server.js"
        }
    },
    "files": [
        "dist",
        "LICENSE-MIT",
        "LICENSE-APACHE",
        "README.md",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && bun run typecheck",
        "test": "bun test",
        "coverage": "bun test --coverage",
        "prepublishOnly": "bun run check && bun run build && bun run coverage",
        "prepare": "git config core.hooksPath .githooks || true"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "js-yaml": "^5.5.0",
        "vscode-languageserver": "^11.0.1",
        "vscode-languageserver-textdocument": "^1.0.16",
        "vscode-languageserver-types": "^3.18.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@types/bun": "^1.4.5",
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2"
    }
}
